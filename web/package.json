{
  "name": "pits-fc-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint --max-warnings=0",
    "formatear": "prettier --write .",
    "formatear:comprobar": "prettier --check .",
    "formatear:tipos": "prettier --write src/app/core/supabase/interfaces/database.types.ts",
    "verificar": "npm run lint && npm run formatear:comprobar && npm run test:ci && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "description": "Web de PITS FC (Angular).",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "*.{ts,html,scss,json,md}": "prettier --write"
  }
}
